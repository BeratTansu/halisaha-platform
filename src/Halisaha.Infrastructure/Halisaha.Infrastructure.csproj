<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Halisaha.Application\Halisaha.Application.csproj" />
    <ProjectReference Include="..\Halisaha.Domain\Halisaha.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SignInManager (L4) ve AddAuthentication paketle değil ASP.NET Core paylaşılan framework'üyle gelir; sürümü
         makinede kurulu runtime'dır (10.0.x), paket sürümü değil. Karar 11, Dilim 2 notları. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <!-- JwtBearer 10.0.14'ün (Api) getirdiği sürümle aynı: projede tek IdentityModel sürümü olsun. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Seed\locations.json" LogicalName="Halisaha.Infrastructure.Persistence.Seed.locations.json" />
    <InternalsVisibleTo Include="Halisaha.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
