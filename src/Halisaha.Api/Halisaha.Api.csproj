<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Development'ta Jwt:SigningKey buradan okunur (repoya girmez). Id yalnızca makinedeki secrets klasörünü seçer. -->
    <UserSecretsId>halisaha-api-6c3f1e0a-5b7d-4a2e-9f84-1d6b3c8e7a52</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Halisaha.Application\Halisaha.Application.csproj" />
    <ProjectReference Include="..\Halisaha.Infrastructure\Halisaha.Infrastructure.csproj" />
  </ItemGroup>

</Project>
