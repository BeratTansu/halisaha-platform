{
  "info": {
    "name": "Halısaha Platformu API",
    "description": "Register → Login → Me akışı ve auth sözleşmesinin hata durumları. Ayrıntı: docs/postman/README.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Her çalıştırmada yeni bir e-posta: collection aynı veritabanında tekrar tekrar çalışabilir (409 çakışması olmaz).",
                  "pm.collectionVariables.set('email', `newman+${pm.variables.replaceIn('{{$guid}}')}@test.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 + userId', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.userId).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.collectionVariables.set('userId', json.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Ahmet\",\n  \"lastName\": \"Yılmaz\",\n  \"phoneNumber\": null,\n  \"preferredPosition\": \"Forward\",\n  \"skillLevel\": 3,\n  \"preferredDistrictId\": {{districtId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2. Register aynı e-posta → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 auth.email_taken', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('auth.email_taken');",
                  "    pm.expect(json.traceId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Ahmet\",\n  \"lastName\": \"Yılmaz\",\n  \"phoneNumber\": null,\n  \"preferredPosition\": \"Forward\",\n  \"skillLevel\": 3,\n  \"preferredDistrictId\": {{districtId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "3. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + AuthResponse', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(Object.keys(json).sort()).to.eql(['accessToken', 'expiresIn', 'userId']);",
                  "    pm.expect(json.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(json.expiresIn).to.be.above(0);",
                  "    // Sonraki isteklerin Authorization başlığı bu değişkenden gelir.",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "});",
                  "pm.test('Token cevabı önbelleğe girmez', () => {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "4. Login yanlış parola → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 auth.invalid_credentials', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('auth.invalid_credentials');",
                  "    pm.expect(json.traceId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('WWW-Authenticate: Bearer (istekte token yok)', () => {",
                  "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"yanlis-parola1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "5. Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + kendi bilgilerim', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(json.profile.preferredPosition).to.eql('Forward');",
                  "    pm.expect(json.profile.district.id).to.eql(Number(pm.environment.get('districtId')));",
                  "    pm.expect(json.profile.province.name).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "6. Me token yok → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 auth.unauthenticated', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('auth.unauthenticated');",
                  "    pm.expect(json.traceId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('WWW-Authenticate: Bearer (RFC 6750 3.1: token yoksa hata kodu yok)', () => {",
                  "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "7. Me geçersiz token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 auth.unauthenticated', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('auth.unauthenticated');",
                  "    pm.expect(json.traceId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('WWW-Authenticate: invalid_token', () => {",
                  "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer error=\"invalid_token\"');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "bu-bir-jwt-degil",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "password",
      "value": "halisaha1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ]
}
